{
    "name": "laravel-route-pattern-finder",
    "displayName": "Laravel Route Pattern Finder",
    "description": "Find Laravel routes that match route:list output, and search the Blade view you have open in VS Code using a keyboard shortcut.",
    "version": "1.4.2",
    "publisher": "mohmmedaliD",
    "repository": {
        "type": "git",
        "url": "https://github.com/mohmmedaliD/laravel-blade-and-route-search"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:laravelBlade.searchView",
        "onCommand:laravelBlade.lrsearch",
        "onView:laravelBlade.routeSearchView"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "laravelBlade.searchView",
                "title": "Laravel: Search Blade View in Controllers"
            },
            {
                "command": "laravelBlade.lrsearch",
                "title": "lrsearch: Open Laravel Route Search"
            }
        ],
        "keybindings": [
            {
                "command": "laravelBlade.searchView",
                "key": "ctrl+shift+q",
                "mac": "cmd+shift+q"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "laravelSearch",
                    "title": "Laravel Search",
                    "icon": "icon.svg"
                }
            ]
        },
        "views": {
            "laravelSearch": [
                {
                    "type": "webview",
                    "id": "laravelBlade.routeSearchView",
                    "name": "Route Search",
                    "contextualTitle": "Laravel Route Search",
                    "icon": "icon.svg"
                }
            ]
        }
    }
}